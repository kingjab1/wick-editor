diff --git a/src/Editor/Modals/Learn/Learn.jsx b/src/Editor/Modals/Learn/Learn.jsx
new file mode 100644
index 0000000..5bf5a65
--- /dev/null
+++ b/src/Editor/Modals/Learn/Learn.jsx
@@ -0,0 +1,205 @@
+/*
+ * Learn: example exercises and animation principles.
+ *
+ * Content is fetched at runtime from /learn/catalog.json, which is generated
+ * from the files in /learn/examples (see learn/README.md in the site repo).
+ * Adding an example never requires rebuilding the editor.
+ *
+ * This file is part of a modified version of Wick Editor and is licensed
+ * under the GNU General Public License v3 or later.
+ */
+
+import React, { Component } from 'react';
+import WickModal from 'Editor/Modals/WickModal/WickModal';
+
+import './_learn.scss';
+
+class Learn extends Component {
+  constructor (props) {
+    super(props);
+
+    this.state = {
+      catalog: null,
+      error: false,
+      view: 'exercises',
+      filter: null,
+    };
+  }
+
+  static get ROOT () {
+    return process.env.PUBLIC_URL + '/learn/';
+  }
+
+  componentDidUpdate (prevProps) {
+    if (this.props.open && !prevProps.open) {
+      this.loadCatalog();
+    }
+  }
+
+  loadCatalog = () => {
+    // Always refetch so newly added examples show up without reloading the editor.
+    fetch(Learn.ROOT + 'catalog.json?t=' + Date.now())
+      .then(resp => {
+        if (!resp.ok) throw new Error('HTTP ' + resp.status);
+        return resp.json();
+      })
+      .then(catalog => {
+        this.setState({
+          catalog: {
+            principles: catalog.principles || [],
+            exercises: catalog.exercises || [],
+          },
+          error: false,
+        });
+      })
+      .catch(e => {
+        console.error('Learn: could not load catalog', e);
+        if (!this.state.catalog) this.setState({ error: true });
+      });
+  }
+
+  principleName = (id) => {
+    let p = this.state.catalog.principles.find(p => p.id === id);
+    return p ? p.name : id;
+  }
+
+  exercisesFor = (principleId) => {
+    return this.state.catalog.exercises.filter(ex => (ex.principles || []).indexOf(principleId) !== -1);
+  }
+
+  showPrinciple = (principleId) => {
+    this.setState({ view: 'exercises', filter: principleId });
+  }
+
+  open = (exercise) => {
+    this.props.openLearnExample(exercise);
+  }
+
+  renderChip = (id, key) => {
+    let active = this.state.filter === id;
+    return (
+      <button
+        key={key || id}
+        className={'learn-chip' + (active ? ' learn-chip-active' : '')}
+        onClick={(e) => {
+          e.stopPropagation();
+          this.setState({ view: 'exercises', filter: active ? null : id });
+        }}>
+        {this.principleName(id)}
+      </button>
+    );
+  }
+
+  renderExercise = (exercise) => {
+    return (
+      <div
+        key={exercise.id}
+        className='learn-card'
+        role='button'
+        onClick={() => this.open(exercise)}>
+        <div className='learn-card-preview'>
+          {exercise.preview
+            ? <img alt={exercise.title} loading='lazy' src={Learn.ROOT + exercise.preview} />
+            : <div className='learn-card-placeholder'>{exercise.title.charAt(0)}</div>}
+        </div>
+        <div className='learn-card-title'>{exercise.title}</div>
+        {exercise.description && <div className='learn-card-description'>{exercise.description}</div>}
+        <div className='learn-chips'>
+          {(exercise.principles || []).map(id => this.renderChip(id))}
+          {(exercise.tags || []).map(tag => <span key={'tag-' + tag} className='learn-chip learn-chip-tag'>{tag}</span>)}
+        </div>
+      </div>
+    );
+  }
+
+  renderExercises = () => {
+    let { catalog, filter } = this.state;
+    let list = filter ? this.exercisesFor(filter) : catalog.exercises;
+
+    return (
+      <div className='learn-scroll'>
+        {filter &&
+          <div className='learn-filter-bar'>
+            Showing: <b>{this.principleName(filter)}</b>
+            <button className='learn-link' onClick={() => this.setState({ filter: null })}>Show all</button>
+          </div>}
+
+        {list.length === 0
+          ? <div className='learn-empty'>
+              {filter ? 'No exercises for this principle yet.' : 'Examples are on the way. Check back soon!'}
+            </div>
+          : <div className='learn-grid'>{list.map(this.renderExercise)}</div>}
+      </div>
+    );
+  }
+
+  renderPrinciples = () => {
+    return (
+      <div className='learn-scroll'>
+        {this.state.catalog.principles.map(principle => {
+          let exercises = this.exercisesFor(principle.id);
+          return (
+            <div key={principle.id} className='learn-principle'>
+              <div className='learn-principle-header'>
+                <div className='learn-principle-name'>{principle.name}</div>
+                {exercises.length > 0 &&
+                  <button className='learn-link' onClick={() => this.showPrinciple(principle.id)}>
+                    See {exercises.length === 1 ? '1 exercise' : exercises.length + ' exercises'}
+                  </button>}
+              </div>
+              {principle.description && <div className='learn-principle-description'>{principle.description}</div>}
+              {exercises.length > 0 &&
+                <div className='learn-principle-exercises'>
+                  {exercises.map(ex =>
+                    <button key={ex.id} className='learn-principle-exercise' onClick={() => this.open(ex)}>
+                      {ex.preview && <img alt='' loading='lazy' src={Learn.ROOT + ex.preview} />}
+                      <span>{ex.title}</span>
+                    </button>)}
+                </div>}
+            </div>
+          );
+        })}
+      </div>
+    );
+  }
+
+  renderBody = () => {
+    if (this.state.error) {
+      return <div className='learn-empty'>Couldn't load the examples. Check your internet connection and try again.</div>;
+    }
+    if (!this.state.catalog) {
+      return <div className='learn-empty'>Loading...</div>;
+    }
+    return this.state.view === 'exercises' ? this.renderExercises() : this.renderPrinciples();
+  }
+
+  render () {
+    let tab = (view, label) =>
+      <button
+        className={'learn-tab' + (this.state.view === view ? ' learn-tab-active' : '')}
+        onClick={() => this.setState({ view: view })}>
+        {label}
+      </button>;
+
+    return (
+      <WickModal
+        open={this.props.open}
+        toggle={this.props.toggle}
+        className='modal-body learn-modal-body'
+        overlayClassName='modal-overlay learn-modal-overlay'>
+        <div className='learn'>
+          <div className='learn-header'>
+            <div className='learn-title'>Learn</div>
+            <div className='learn-tabs'>
+              {tab('exercises', 'Exercises')}
+              {tab('principles', 'Principles')}
+            </div>
+          </div>
+          {this.renderBody()}
+        </div>
+      </WickModal>
+    );
+  }
+}
+
+export default Learn;
