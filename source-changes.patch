+
+.learn-card-preview {
+  width: 100%;
+  aspect-ratio: 16 / 9;
+  background: white;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  overflow: hidden;
+
+  img {
+    width: 100%;
+    height: 100%;
+    object-fit: contain;
+  }
+}
+
+// Older Safari has no aspect-ratio support
+@supports not (aspect-ratio: 16 / 9) {
+  .learn-card-preview { height: 130px; }
+}
+
+.learn-card-placeholder {
+  font-size: 48px;
+  font-weight: bold;
+  color: $editor-modal-gray-secondary;
+}
+
+.learn-card-title {
+  font-size: 16px;
+  font-weight: bold;
+  color: $editor-modal-text-white;
+  padding: 8px 10px 2px 10px;
+}
+
+.learn-card-description {
+  font-size: 13px;
+  color: $editor-modal-text-dark;
+  padding: 2px 10px;
+}
+
+.learn-chips {
+  display: flex;
+  flex-wrap: wrap;
+  padding: 6px 8px 10px 8px;
+}
+
+.learn-chip {
+  border: 1px solid $editor-modal-gray-secondary;
+  background: transparent;
+  color: $editor-modal-text-gray;
+  font-size: 12px;
+  border-radius: 12px;
+  padding: 3px 9px;
+  margin: 2px;
+  cursor: pointer;
+}
+
+.learn-chip-active {
+  background: $editor-green-highlight;
+  border-color: $editor-green-highlight;
+  color: $editor-primary;
+}
+
+.learn-chip-tag {
+  cursor: default;
+  border-style: dashed;
+}
+
+.learn-filter-bar {
+  margin-bottom: 10px;
+  font-size: 14px;
+}
+
+.learn-link {
+  border: none;
+  background: transparent;
+  color: $editor-green-highlight;
+  font-size: 14px;
+  font-weight: bold;
+  padding: 4px 8px;
+  cursor: pointer;
+}
+
+.learn-empty {
+  padding: 40px 10px;
+  text-align: center;
+  color: $editor-modal-text-dark;
+  font-size: 16px;
+}
+
+.learn-principle {
+  background: $editor-modal-dark;
+  border-radius: 8px;
+  padding: 10px 12px;
+  margin-bottom: 10px;
+}
+
+.learn-principle-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+}
+
+.learn-principle-name {
+  font-size: 16px;
+  font-weight: bold;
+  color: $editor-modal-text-white;
+}
+
+.learn-principle-description {
+  font-size: 14px;
+  color: $editor-modal-text-dark;
+  margin-top: 4px;
+}
+
+.learn-principle-exercises {
+  display: flex;
+  flex-wrap: wrap;
+  margin-top: 8px;
+}
+
+.learn-principle-exercise {
+  display: flex;
+  align-items: center;
+  border: 1px solid $editor-modal-gray-secondary;
+  background: $editor-modal-gray;
+  color: $editor-modal-text-gray;
+  border-radius: 6px;
+  padding: 4px 10px 4px 4px;
+  margin: 3px;
+  font-size: 13px;
+  cursor: pointer;
+
+  img {
+    width: 44px;
+    height: 26px;
+    object-fit: contain;
+    background: white;
+    border-radius: 3px;
+    margin-right: 6px;
+  }
+}
