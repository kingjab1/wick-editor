+  loadLearn = () => {
+    cloud.listLearn().then(items => this.setState({ learnItems: items })).catch(e => this.setState({ error: cloud.message(e) }));
+    if (!this.state.principles.length) {
+      fetch(process.env.PUBLIC_URL + '/learn/catalog.json?t=' + Date.now())
+        .then(r => r.json()).then(c => this.setState({ principles: c.principles || [] })).catch(() => {});
+    }
+  }
