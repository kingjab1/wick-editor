+.learn-tab {
+  border: none;
+  background: transparent;
+  color: $editor-modal-text-dark;
+  font-size: 15px;
+  font-weight: bold;
+  padding: 7px 16px;
+  border-radius: 6px;
+  cursor: pointer;
+}
+
+.learn-tab-active {
+  background: $editor-green-highlight;
+  color: $editor-primary;
+}
+
+.learn-scroll {
+  flex: 1;
+  overflow-y: auto;
+  -webkit-overflow-scrolling: touch;
+  padding-right: 4px;
+}
+
+.learn-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
+  grid-gap: 14px;
+  padding-bottom: 10px;
+}
+
+.learn-card {
+  background: $editor-modal-dark;
+  border-radius: 8px;
+  overflow: hidden;
+  cursor: pointer;
+  display: flex;
+  flex-direction: column;
+  border: 2px solid transparent;
+
+  &:hover, &:active {
+    border-color: $editor-green-highlight;
+  }
