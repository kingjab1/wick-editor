+        open={this.props.open}
+        toggle={this.props.toggle}
+        className='modal-body mywork-modal-body'
+        overlayClassName='modal-overlay mywork-modal-overlay'>
+        <div className='mywork'>
+          <div className='mywork-title'>My Work</div>
+          {this.state.error && <div className='mywork-error'>{this.state.error}</div>}
+          {this.renderBody()}
+        </div>
+      </WickModal>
+    );
+  }
+}
+
+export default MyWork;
