+  editLearn = (item) => {
+    this.setState({ learnForm: { cloudId: item ? item.cloudId : null, title: item ? item.title : '', description: item ? item.description || '' : '',
+      principles: item ? (item.principles || []).slice() : [], replaceFile: !item } });
+  }
+
+  setLearnForm = (patch) => this.setState({ learnForm: Object.assign({}, this.state.learnForm, patch) });
+
+  togglePrinciple = (id) => {
+    let list = this.state.learnForm.principles.slice();
+    let i = list.indexOf(id);
+    if (i === -1) list.push(id); else list.splice(i, 1);
+    this.setLearnForm({ principles: list });
+  }
+
+  publishLearn = (e) => {
+    e.preventDefault();
+    let f = this.state.learnForm;
+    let title = f.title.trim();
+    if (!title) { this.setState({ error: 'Give the example a title.' }); return; }
+    let info = { title: title, description: f.description.trim(), principles: f.principles };
+    let job;
+    if (f.cloudId && !f.replaceFile) {
+      job = () => cloud.updateLearnInfo(f.cloudId, info);
+    } else {
+      job = () => this.props.getProjectForCloud().then(p =>
+        cloud.publishLearn(Object.assign({ cloudId: f.cloudId, preview: p.thumb, blob: p.blob }, info)));
+    }
+    this.run(job, f.cloudId ? 'Updated "' + title + '" in Learn.' : 'Published "' + title + '" to Learn.')
+      .then(() => { this.editLearn(null); this.loadLearn(); }).catch(() => {});
+  }
+
+  deleteLearn = (item) => {
+    let key = 'learn:' + item.cloudId;
+    if (this.state.confirmDelete !== key) { this.setState({ confirmDelete: key }); return; }
+    this.run(() => cloud.deleteLearn(item.cloudId), 'Removed "' + item.title + '" from Learn.')
+      .then(() => { this.setState({ confirmDelete: null }); if (this.state.learnForm.cloudId === item.cloudId) this.editLearn(null); this.loadLearn(); })
+      .catch(() => {});
